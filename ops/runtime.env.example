# Copy this file to /opt/infinite-canvas/runtime.env on the server.
# Never commit the real file.
APP_ORIGIN=https://canvas.yigeai.work
APP_SECURE_COOKIES=true
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
BOOTSTRAP_ADMIN_USERNAME=admin
# Remove the bootstrap password from runtime.env after the first successful
# login and after confirming that /opt/infinite-canvas/data is persistent.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
